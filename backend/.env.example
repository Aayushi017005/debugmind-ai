# DebugMind AI Backend Environment Variables

# Server Port
PORT=5000

# Groq LLM API Key (Required for AI analysis)
# Obtain a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Connection String (Optional, enables persistent debugging history)
# Formats:
# Local: postgresql://postgres:password@localhost:5432/debugmind
# Cloud (Render / Neon / Supabase): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/debugmind

